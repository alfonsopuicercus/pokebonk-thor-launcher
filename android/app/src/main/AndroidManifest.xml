<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <queries>
        <package android:name="com.android.chrome" />
        <intent><action android:name="android.intent.action.VIEW" /><category android:name="android.intent.category.BROWSABLE" /><data android:scheme="https" /></intent>
    </queries>
    <application android:label="Pokébonk for Thor" android:icon="@drawable/launcher_icon" android:allowBackup="false" android:supportsRtl="true" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".GameActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden|keyboard" android:enableOnBackInvokedCallback="false" />
        <activity android:name=".LauncherActivity" android:exported="true" android:resizeableActivity="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
